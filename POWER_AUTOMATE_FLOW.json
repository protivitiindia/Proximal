{
  "powerAutomate": {
    "flowName": "ROPA to DFD Converter",
    "trigger": "When a file is created (properties only)",
    "steps": [
      {
        "name": "Get file content",
        "type": "SharePoint",
        "action": "Get file content",
        "inputs": {
          "site": "YOUR_SHAREPOINT_SITE",
          "library": "Shared Documents",
          "id": "@triggerBody()?['ID']"
        }
      },
      {
        "name": "Convert Excel to DFD SVG",
        "type": "HTTP",
        "action": "HTTP",
        "inputs": {
          "method": "POST",
          "uri": "https://YOUR_RENDER_URL.onrender.com/convert",
          "headers": {
            "Content-Type": "application/octet-stream"
          },
          "body": "@body('Get file content')"
        }
      },
      {
        "name": "Create DFD file in SharePoint",
        "type": "SharePoint",
        "action": "Create file",
        "inputs": {
          "site": "YOUR_SHAREPOINT_SITE",
          "library": "Shared Documents",
          "folderPath": "/DFD Diagrams",
          "filename": "@concat(replace(triggerOutputs()?['headers']?['x-ms-file-name'], '.xlsx', ''), '_DFD.svg')",
          "file_content": "@body('Convert Excel to DFD SVG')"
        }
      },
      {
        "name": "Create shareable link",
        "type": "SharePoint",
        "action": "Create sharing link for a file or folder",
        "inputs": {
          "id": "@outputs('Create DFD file in SharePoint')?['body']?['ID']",
          "linkType": "view",
          "scope": "organization"
        }
      }
    ]
  }
}
